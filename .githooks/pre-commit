#!/bin/sh
# Keeps docs/architecture.html in step with the plugin files: when the page is out of date,
# regenerate it and add it to the commit being made.
# Turn on once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

python3 tools/build-docs.py --check >/dev/null 2>&1 && exit 0

python3 tools/build-docs.py || {
    echo "pre-commit: tools/build-docs.py failed; fix it or commit with --no-verify" >&2
    exit 1
}
git add docs/architecture.html docs/.nojekyll || exit 1
echo "pre-commit: regenerated docs/architecture.html and added it to this commit"

# The generator reads the working tree, not the staged files.
if ! git diff --quiet -- plugins tools; then
    echo "pre-commit: note: plugins/ or tools/ has unstaged changes; the page was built from them too" >&2
fi
exit 0
